# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA commite o arquivo ".env" (ele já está no .gitignore).
# Contrato completo: specs/001-bot-alertas-vagas/contracts/environment-variables.md

# --- Obrigatórias ---

# Connection string completa do Neon Postgres, incluindo SSL.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.us-east-2.aws.neon.tech/bot_vagas?sslmode=require

# Token do bot, obtido via @BotFather no Telegram.
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID numerico do chat/usuario/canal que deve receber os alertas.
# Positivo para chat pessoal, negativo para grupo.
TELEGRAM_CHAT_ID=987654321

# --- Opcionais (valores abaixo são os defaults usados se ausentes) ---

# Verbosidade dos logs da execução.
LOG_LEVEL=INFO

# User-Agent enviado nas requisições de scraping.
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
